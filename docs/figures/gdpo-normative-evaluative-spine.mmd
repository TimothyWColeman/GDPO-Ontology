flowchart TB
    accTitle: Three reusable GDPO design patterns
    accDescr: Four vertically stacked panels show the prescription-component pattern, criterion-method relevance, criterion-subject assessment pattern, and a notation key. Rectangular nodes denote classes or class expressions. Rounded nodes denote named individuals. Solid arrows denote asserted relations, OWL restrictions, or subclass axioms. Dotted arrows denote inferences. In the third panel, individual A1 is one assessment component that jointly identifies individual H1, an honesty statement, and individual U1, SK4 user-manual content. Its parent individual E2 is inferred to instantiate the communicative-honesty evaluation class.

    subgraph prescriptionPattern ["A. Prescription-component pattern"]
        direction LR
        principleClass["Rams principle category [class]"]
        targetExpression["Artifact-side target [class expression]"]
        componentExpression["Prescription component [class]"]
        processExpression["Prescribed process [class expression]"]

        principleClass -->|"aims at target only"| targetExpression
        principleClass -->|"has component some"| componentExpression
        componentExpression -->|"prescribes only"| processExpression
    end

    subgraph relevancePattern ["B. Criterion–method relevance pattern"]
        direction LR
        evaluationRecord(["E1: SK4 durability evaluation"])
        selectedStatement(["C1: durability statement"])
        methodSpec(["M1: durability rubric"])
        methodPrinciple(["P1: environmental<br/>friendliness statement"])

        evaluationRecord -->|"against principle"| selectedStatement
        evaluationRecord -->|"is about using method"| methodSpec
        methodSpec -->|"operationalizes principle"| methodPrinciple
        evaluationRecord -.->|"inferred relevant principle"| methodPrinciple
    end

    subgraph subjectPattern ["C. Criterion-subject assessment pattern"]
        direction LR
        subjectRecord(["E2: SK4 manual-honesty evaluation"])
        assessmentComponent(["A1: assessment component (one criterion + one subject)"])
        honestyStatement(["H1: honesty statement"])
        communicationContent(["U1: SK4 user-manual content"])
        communicativeClass["Communicative honesty evaluation [class]"]
        honestyClass["Honesty evaluation [class]"]

        subjectRecord -->|"has assessment<br/>component"| assessmentComponent
        assessmentComponent -->|"has assessment<br/>criterion"| honestyStatement
        assessmentComponent -->|"has assessed<br/>subject"| communicationContent
        subjectRecord -.->|"inferred rdf:type"| communicativeClass
        communicativeClass -->|"subclass of"| honestyClass
    end

    subgraph notationKey ["D. Notation key"]
        direction LR
        keyClass["Rectangle: class or class expression"]
        keyIndividual(["Rounded node: named individual"])

        keyClass -->|"solid"| keyIndividual
        keyIndividual -.->|"dotted"| keyClass
    end

    %% Layout-only invisible links keep the three patterns stacked A to C.
    processExpression ~~~ evaluationRecord
    methodPrinciple ~~~ subjectRecord
    honestyClass ~~~ keyClass

    classDef patternNode fill:#ffffff,stroke:#222222,stroke-width:3px,color:#111111

    class principleClass,targetExpression,componentExpression,processExpression,evaluationRecord,selectedStatement,methodSpec,methodPrinciple,subjectRecord,assessmentComponent,honestyStatement,communicationContent,communicativeClass,honestyClass,keyClass,keyIndividual patternNode

    style prescriptionPattern fill:#f7f7f7,stroke:#666666,stroke-width:2px,color:#111111
    style relevancePattern fill:#f7f7f7,stroke:#666666,stroke-width:2px,color:#111111
    style subjectPattern fill:#f7f7f7,stroke:#666666,stroke-width:2px,color:#111111
    style notationKey fill:#f7f7f7,stroke:#666666,stroke-width:2px,color:#111111
