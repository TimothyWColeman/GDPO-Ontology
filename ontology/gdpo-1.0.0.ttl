                                                     ]
                                 ] ;
                 rdfs:label "principle of honesty"@en ;
                 skos:definition "A design principle that aims at the artifact-side target design honesty."@en ;
                 skos:editorialNote "Distinguish material honesty (true to materials), functional honesty (controls reflect real capabilities), and communicative honesty (marketing matches performance)."@en ,
                                    "Modeling note: The target restriction for principle of honesty embeds the expanded honesty target expression, decomposing material honesty and functional honesty in terms of bearers, bases, and realization processes, in alignment with Appendix A2.1 of the paper."@en ,
                                    "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ;
                 skos:prefLabel "principle of honesty"@en ;
                 skos:scopeNote "Communicative honesty is captured via evaluation records of communication artifacts (manuals, labels, advertisements), not as a product-borne disposition."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000026
gdpo:GDPO0000026 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000003 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000062 ;
                                   owl:someValuesFrom [ owl:intersectionOf ( gdpo:GDPO0000061
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty cco:ont00001942 ;
                                                                               owl:allValuesFrom gdpo:GDPO0000018
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty gdpo:GDPO0000063 ;
                                                                               owl:allValuesFrom gdpo:GDPO0000039
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000454 ;
                                   owl:allValuesFrom gdpo:GDPO0000010
                                 ] ;
                 rdfs:label "principle of durability"@en ;
                 skos:definition "A design principle that aims at the artifact-side target design durability."@en ;
                 skos:editorialNote "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ,
                                    "Tie to conformance with test standards (e.g., durability test protocols); capture warranty or expected lifespan as annotations."@en ;
                 skos:prefLabel "principle of durability"@en ;
                 skos:scopeNote "Guides designers to ensure artifacts maintain integrity and function under normal conditions over an extended lifespan."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000027
gdpo:GDPO0000027 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000003 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000062 ;
                                   owl:someValuesFrom [ owl:intersectionOf ( gdpo:GDPO0000061
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty cco:ont00001942 ;
                                                                               owl:allValuesFrom gdpo:GDPO0000032
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000454 ;
                                   owl:allValuesFrom gdpo:GDPO0000011
                                 ] ;
                 rdfs:label "principle of thoroughness"@en ;
                 skos:definition "A design principle that aims at the artifact-side target design thoroughness quality."@en ;
                 skos:editorialNote "Apply to systems and ecosystems, not just the core artifact. Use part-whole reasoning across packaging, accessories, documentation."@en ,
                                    "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ;
                 skos:prefLabel "principle of thoroughness"@en ;
                 skos:scopeNote "Directs designers to attend to detail “down to the last” element of form, function, and integration."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000028
gdpo:GDPO0000028 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000003 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000062 ;
                                   owl:someValuesFrom [ owl:intersectionOf ( gdpo:GDPO0000061
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty cco:ont00001942 ;
                                                                               owl:allValuesFrom gdpo:GDPO0000019
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty gdpo:GDPO0000063 ;
                                                                               owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                                   owl:unionOf ( gdpo:GDPO0000036
                                                                                                                 gdpo:GDPO0000037
                                                                                                                 gdpo:GDPO0000038
                                                                                                                 gdpo:GDPO0000039
                                                                                                                 gdpo:GDPO0000040
                                                                                                               )
                                                                                                 ]
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000454 ;
                                   owl:allValuesFrom gdpo:GDPO0000012
                                 ] ;
                 rdfs:label "principle of environmental friendliness"@en ;
                 skos:definition "A design principle that aims at a design lifecycle environmental performance profile representing an assessment of a specified product system."@en ;
                 skos:editorialNote "The target is a context-indexed measurement profile rather than an intrinsic quality of the artifact. Model lifecycle stages (sourcing, manufacturing, distribution, use/maintenance, and end-of-life) as processes, represent actual environmental impacts separately, and state the product system, lifecycle boundary and stages, method, functional unit, baseline, and assessment time needed to interpret the profile."@en ,
                                    "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ;
                 skos:prefLabel "principle of environmental friendliness"@en ;
                 skos:scopeNote "Guides design to minimize adverse ecological impact across an artifact’s entire lifecycle."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000029
gdpo:GDPO0000029 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000003 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000062 ;
                                   owl:someValuesFrom [ owl:intersectionOf ( gdpo:GDPO0000061
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty cco:ont00001942 ;
                                                                               owl:allValuesFrom gdpo:GDPO0000033
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000454 ;
                                   owl:allValuesFrom gdpo:GDPO0000013
                                 ] ;
                 rdfs:label "principle of minimalism"@en ;
                 skos:definition "A design principle that aims at the artifact-side target design minimalism quality."@en ;
                 skos:editorialNote "Distinguish from “impoverished function.” Allow justified exceptions where complexity is necessary (e.g., safety or accessibility cues)."@en ,
                                    "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ;
                 skos:prefLabel "principle of minimalism"@en ;
                 skos:scopeNote "Directs design to reduce artifacts to essential elements, eliminating superfluous features in support of “less, but better.”"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000030
gdpo:GDPO0000030 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom cco:ont00001017
                                 ] ;
                 rdfs:label "design aesthetic development process"@en ;
                 skos:definition "A process in which an agent develops or refines the form, proportion, harmony, and material finish of a designed artifact."@en ;
                 skos:prefLabel "design aesthetic development process"@en ;
                 skos:scopeNote "Guides perceptual coherence and appeal without committing to a particular style."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000031
gdpo:GDPO0000031 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom cco:ont00001017
                                 ] ;
                 rdfs:label "design contextual integration process"@en ;
                 skos:altLabel "design environmental integration process"@en ;
                 skos:definition "A process that integrates visual and signal salience of the artifact with its setting."@en ;
                 skos:editorialNote "Distinguish from minimalism; unobtrusive ≠ austere when signaling (e.g., safety) is required."@en ,
                                    "Renamed from 'design environmental integration process' to reduce confusion with ecological 'environmental friendliness'; this process is about contextual fit and perceptual salience."@en ;
                 skos:prefLabel "design contextual integration process"@en ;
                 skos:scopeNote "Here 'environment' means the artifact's usage setting/context (e.g., visual environment), not ecological sustainability. Use design environmental friendliness for ecological impact across lifecycle."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000032
gdpo:GDPO0000032 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom cco:ont00001017
                                 ] ;
                 rdfs:label "design thoroughness assurance process"@en ;
                 skos:definition "A process that ensures completeness and fit-and-finish across an artifact's parts and ecosystem, including packaging, documentation, and accessories."@en ;
                 skos:prefLabel "design thoroughness assurance process"@en ;
                 skos:scopeNote "Ensures attention 'down to the last detail' across all system components."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000033
gdpo:GDPO0000033 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom cco:ont00001017
                                 ] ;
                 rdfs:label "design reduction process"@en ;
                 skos:definition "A process that eliminates superfluous elements to achieve sufficiency with minimal complexity."@en ;
                 skos:editorialNote "Distinguish from impoverished function; allow justified exceptions for safety/accessibility cues."@en ;
                 skos:prefLabel "design reduction process"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000034
gdpo:GDPO0000034 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000035 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000020
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000021
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000022
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000023
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000024
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000025
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000026
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000027
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000028
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:someValuesFrom gdpo:GDPO0000029
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000060 ;
                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( gdpo:GDPO0000020
                                                                     gdpo:GDPO0000021
                                                                     gdpo:GDPO0000022
                                                                     gdpo:GDPO0000023
                                                                     gdpo:GDPO0000024
                                                                     gdpo:GDPO0000025
                                                                     gdpo:GDPO0000026
                                                                     gdpo:GDPO0000027
                                                                     gdpo:GDPO0000028
                                                                     gdpo:GDPO0000029
                                                                   )
                                                     ]
                                 ] ;
                 dcterms:creator "Dieter Rams"@en ;
                 rdfs:comment "Modeling note: In GDPO, the compositional structure of this specification is represented using the GDPO-specific relation has principle component. This avoids treating ICE composition as BFO continuant parthood for GDCs."@en ;
                 rdfs:label "rams ten principles specification"@en ;
                 skos:definition "A principle specification that includes, as principle components, each of the ten principles articulated by Dieter Rams (innovativeness, usefulness, aesthetics, understandability, unobtrusiveness, honesty, durability, thoroughness, environmental friendliness, and minimalism)."@en ;
                 skos:editorialNote "Treat this as normative information content authored by Dieter Rams in the 1970s. Represent its compositional structure using the GDPO-specific relation has principle component, preferably by asserting a specification individual (e.g., RamsTenPrinciplesSpecification) that has principle component each of the ten named Rams principle statement individuals. This avoids committing to BFO continuant parthood for GDC/ICE composition. Do not treat this class as logically equivalent to the conjunction of the ten principles for purposes of conformance: Rams’ framework supports graded and context-dependent conformity."@en ;
                 skos:prefLabel "rams ten principles specification"@en ;
                 skos:scopeNote "This class represents the historically bounded Ten Principles of Good Design articulated by Dieter Rams. It is intended to serve as a reference specification against which design artifacts or practices can be evaluated or annotated. The specification supports reasoning and comparison by providing a coherent set of principles that can be contrasted with alternative frameworks of design evaluation. It should be used when modeling Rams’ philosophy as a complete set, while the individual principle classes should be used when annotating specific features of artifacts or design processes."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000035
gdpo:GDPO0000035 rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "principle specification"@en ;
                 skos:definition "An information content entity that organizes one or more normative design principles as components for evaluation or guidance without implying that their guidance is realized."@en ;
                 skos:prefLabel "principle specification"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000036
gdpo:GDPO0000036 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000019 ;
                 owl:disjointWith gdpo:GDPO0000040 ;
                 rdfs:label "design sourcing process"@en ;
                 skos:definition "A design lifecycle stage process in which raw materials, components, or subassemblies are identified, selected, and acquired for use in the production of an artifact."@en ;
                 skos:editorialNote "Distinguish sourcing from distribution (outward supply) and from manufacturing (transformation). Capture provenance, supplier roles, and sustainability criteria as annotations or linked processes."@en ;
                 skos:prefLabel "design sourcing process"@en ;
                 skos:scopeNote "Includes activities such as material selection, supplier engagement, procurement, and logistics prior to manufacturing. Relevant for evaluating environmental friendliness and supply chain ethics."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000037
gdpo:GDPO0000037 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000019 ;
                 owl:disjointWith gdpo:GDPO0000040 ;
                 rdfs:label "design manufacturing process"@en ;
                 skos:definition "A design lifecycle stage process in which sourced materials or components are transformed into a finished artifact or subartifact through fabrication, assembly, or production operations."@en ;
                 skos:editorialNote "Differentiate from sourcing (which provides inputs) and from distribution (which delivers outputs). Manufacturing is the locus where material transformation and artifact realization occur."@en ;
                 skos:prefLabel "design manufacturing process"@en ;
                 skos:scopeNote "Covers processes such as fabrication, machining, assembly, finishing, and quality assurance. May be specialized by industry (e.g., semiconductor fabrication, textile production)."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000038
gdpo:GDPO0000038 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000019 ;
                 owl:disjointWith gdpo:GDPO0000040 ;
                 rdfs:label "design distribution process"@en ;
                 skos:definition "A design lifecycle stage process in which finished artifacts are packaged, transported, and delivered from a point of manufacture or storage to agents or end-users."@en ;
                 skos:editorialNote "Do not conflate with sourcing (inbound materials acquisition). Distribution concerns outward logistics of finished goods."@en ;
                 skos:prefLabel "design distribution process"@en ;
                 skos:scopeNote "Covers processes of packaging, warehousing, shipping, retail logistics, and delivery. Evaluation may include carbon footprint, packaging waste, and accessibility of channels."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000039
gdpo:GDPO0000039 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000019 ;
                 owl:disjointWith gdpo:GDPO0000040 ;
                 rdfs:label "design use and maintenance process"@en ;
                 skos:definition "A design lifecycle stage process in which an artifact is operated by an agent for its intended purpose, including routine upkeep or repair activities to sustain functionality over time."@en ;
                 skos:editorialNote "Keep distinct from manufacturing (artifact creation) and end-of-life (artifact retirement). Maintenance should be modeled as its own sub-process where detail is required."@en ;
                 skos:prefLabel "design use and maintenance process"@en ;
                 skos:scopeNote "Includes normal operation, preventive care, repair, software updates, and servicing. Important for assessing usefulness, durability, and environmental friendliness (e.g., repairability index)."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000040
gdpo:GDPO0000040 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000019 ;
                 rdfs:label "design end-of-life handling process"@en ;
                 skos:definition "A design lifecycle stage process in which an artifact, no longer in use, is managed through disposal, recycling, reuse, or repurposing."@en ;
                 skos:editorialNote "Do not conflate with maintenance. End-of-life processes begin only when the artifact is retired from intended use."@en ;
                 skos:prefLabel "design end-of-life handling process"@en ;
                 skos:scopeNote "Includes decommissioning, dismantling, recycling, safe disposal, or secondary use. Relevant to sustainability principles and circular economy modeling."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000041
gdpo:GDPO0000041 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000009 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000218> ;
                                   owl:someValuesFrom gdpo:GDPO0000057
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000054> ;
                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( gdpo:GDPO0000017
                                                                     gdpo:GDPO0000039
                                                                   )
                                                     ]
                                 ] ;
                 rdfs:label "design material honesty"@en ;
                 skos:definition "A design honesty disposition that inheres in a material entity because of its composition, finish, and surface structure and tends, under specified interaction or use conditions, to present cues aligned with the materials from which the artifact is made."@en ;
                 skos:editorialNote """Use when the design avoids disguising, simulating, or concealing the true materials of construction (e.g., plastic made to appear as metal). Keep distinct from functional or design communicative honesty evaluation.

Facet of design honesty; may co-occur with other honesty facets. Do not assert owl:disjointWith."""@en ;
                 skos:prefLabel "design material honesty"@en ;
                 skos:scopeNote "Examples include exposing wood grain, metal finishes, or fabric textures honestly. Violations occur when surface treatments misrepresent underlying materials. Important in evaluating authenticity and sustainability in design."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000042
gdpo:GDPO0000042 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000009 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000218> ;
                                   owl:someValuesFrom gdpo:GDPO0000058
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000054> ;
                                   owl:allValuesFrom gdpo:GDPO0000017
                                 ] ;
                 rdfs:label "design functional honesty"@en ;
                 skos:definition "A design honesty disposition that inheres in a material entity because of its controls, mappings, indicators, and other signaling configuration and tends, under specified interaction conditions, to align apparent affordances and signals with the artifact’s actual capabilities."@en ;
                 skos:editorialNote """Use for cases where interface elements truthfully map to real functions. Distinguish from communicative honesty evaluation (claims/marketing) and material honesty (substances).

Facet of design honesty; may co-occur with other honesty facets. Do not assert owl:disjointWith."""@en ;
                 skos:prefLabel "design functional honesty"@en ;
                 skos:scopeNote "Covers alignment between buttons, levers, displays, or other affordances and the functions they genuinely trigger. Violations include false affordances, non-functional controls, or decorative elements that imply nonexistent functionality."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000044
gdpo:GDPO0000044 rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( cco:ont00000958
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000045 ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000046 ;
                                                              owl:someValuesFrom gdpo:GDPO0000003
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000462 ;
                                                              owl:someValuesFrom gdpo:GDPO0000055
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000468 ;
                                                              owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000008>
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf cco:ont00000958 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000048 ;
                                   owl:allValuesFrom gdpo:GDPO0000052
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000457 ;
                                   owl:allValuesFrom gdpo:GDPO0000456
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000047 ;
                                   owl:allValuesFrom xsd:decimal
                                 ] ;
                 rdfs:label "design evaluation record"@en ;
                 skos:altLabel "design assessment"@en ,
                               "design evaluation"@en ,
                               "design review record"@en ;
                 skos:definition "An information content entity that is produced by a design evaluation process and records an assessment of a specified material entity with respect to one or more design principles during a particular temporal region, optionally using a specified method and yielding one or more scores."@en ;
                 skos:editorialNote "Model this as the resulting record (ICE) and explicitly relate it to at least one producing design evaluation process with is evaluation record output of. The producing process is required; methods and scores remain optional."@en ,
                                    "Truthmaker note: the correctness of the record's evaluative assertions is grounded in (i) the required evaluation process that produced it (e.g., a review, test, or assessment) and (ii) the outcome-bearing configuration measured or observed during that process (e.g., test results, rubric evidence, LCA outputs). Link evidence artifacts when available."@en ;
                 skos:prefLabel "design evaluation record"@en ;
                 skos:scopeNote "Covers rubric-based reviews, usability test summaries, conformance checklists, LCA summaries, etc. Scores may be numeric or absent; the record still qualifies."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000052
gdpo:GDPO0000052 rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cco:ont00001942 ;
                                   owl:allValuesFrom gdpo:GDPO0000055
                                 ] ;
                 rdfs:label "evaluation method specification"@en ;
                 skos:definition "An information content entity that specifies a procedure, rubric, or protocol for evaluating a designed artifact with respect to one or more design principles."@en ;
                 skos:editorialNote "Use as the range of using_method when you don’t want to depend on IAO’s Plan Specification."@en ;
                 skos:prefLabel "evaluation method specification"@en ;
                 skos:scopeNote "Examples: Rams-conformance rubric v1.1, LCA protocol, usability SUS procedure."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000053
gdpo:GDPO0000053 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom cco:ont00001017
                                 ] ;
                 rdfs:label "design communication process"@en ;
                 skos:definition "A process in which an agent produces, transmits, or displays information about a designed artifact (e.g., labeling, manuals, advertising, certification disclosures)."@en ;
                 skos:editorialNote "Keep distinct from design interaction process (operation/controls). Use this for claims, docs, labels, ads; compare claims to measurement data elsewhere."@en ;
                 skos:prefLabel "design communication process"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000055
gdpo:GDPO0000055 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000057> ;
                                   owl:someValuesFrom cco:ont00001017
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000463 ;
                                   owl:someValuesFrom gdpo:GDPO0000044
                                 ] ;
                 rdfs:label "design evaluation process"@en ;
                 skos:altLabel "design assessment process"@en ,
                               "design review process"@en ;
                 skos:definition "A process in which an agent assesses a designed artifact or system, using some evaluation method, and produces a design evaluation record."@en ;
                 skos:editorialNote "Keep distinct from the design evaluation record (an ICE). This class models the occurrent activity that produces the record."@en ;
                 skos:prefLabel "design evaluation process"@en ;
                 skos:scopeNote "Covers activities such as design reviews, usability tests, life-cycle assessments, and rubric-based evaluations. The process outputs a design evaluation record (ICE)."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000056
gdpo:GDPO0000056 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000176> ;
                                   owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                 ] ;
                 rdfs:label "design honesty basis"@en ;
                 skos:definition "A material entity that is a continuant part of an artifact and whose structural or semiotic features ground a design honesty disposition (e.g., features that align perceptible cues with actual materials and functions)."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000057
gdpo:GDPO0000057 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000056 ;
                 rdfs:label "design material honesty basis"@en ;
                 skos:definition "A design honesty basis that grounds a design material honesty disposition by aligning material-related cues (e.g., finish, texture, visible structure) with the bearer's actual material composition."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000058
gdpo:GDPO0000058 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000056 ;
                 rdfs:label "design functional honesty basis"@en ;
                 skos:definition "A design honesty basis that grounds a design functional honesty disposition by aligning functional signifiers (e.g., controls, affordances, indicators) with the bearer's actual functional capabilities."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000061
gdpo:GDPO0000061 rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "design process prescription"@en ;
                 skos:definition "A normative information content entity that specifies constraints for design-relevant processes and may specify applicability conditions, including temporal or lifecycle-stage qualifiers, without requiring that any conforming process occur."@en ;
                 skos:editorialNote "A canonical named prescription is classified with an OWL restriction of the form cco:prescribes only ProcessClass. Following the class-expression strategy for information about the unreal, this constrains any prescribed filler without asserting that a process instance exists. The class is used as a restriction filler; it is not asserted as an individual property value."@en ;
                 skos:prefLabel "design process prescription"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000446
gdpo:GDPO0000446 rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "design communication content entity"@en ;
                 skos:definition "An Information Content Entity that communicates claims, instructions, or disclosures about a designed artifact (e.g., manual text, label statements, advertising claims, specification sheet content)"@en ;
                 skos:editorialNote "This class models the communicated content (ICE), not the physical carrier. Add a bearer later only if you need attachment/copies/media provenance."@en ;
                 skos:prefLabel "design communication content entity"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000447
gdpo:GDPO0000447 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000446 ;
                 rdfs:label "product manual content"@en ;
                 skos:definition "A design communication content entity intended to instruct users in use and maintenance of a designed artifact."@en ;
                 skos:prefLabel "product manual content"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000448
gdpo:GDPO0000448 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000446 ;
                 rdfs:label "product label content"@en ;
                 skos:definition "A design communication content entity that conveys claims or disclosures associated with a designed artifact."@en ;
                 skos:prefLabel "product label content"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000449
gdpo:GDPO0000449 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000446 ;
                 rdfs:label "product advertisement content"@en ;
                 skos:definition "A design communication content entity intended to promote a designed artifact via communicated claims."@en ;
                 skos:prefLabel "product advertisement content"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000452
gdpo:GDPO0000452 rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( gdpo:GDPO0000455
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000469 ;
                                                              owl:someValuesFrom gdpo:GDPO0000473
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf gdpo:GDPO0000455 ;
                 rdfs:label "design communicative honesty evaluation"@en ;
                 skos:altLabel "communicative honesty evaluation"@en ;
                 skos:definition "A design honesty evaluation that has a criterion–subject assessment component pairing a principle of honesty with design communication content, such as manual content, label content, or advertisement content."@en ;
                 skos:editorialNote "This class specializes design honesty evaluation only when one assessment component pairs the honesty criterion with communication content. Direct record-level links to an honesty criterion and to communication content may support broad retrieval, but do not by themselves establish the required pairing in a composite record."@en ;
                 skos:prefLabel "design communicative honesty evaluation"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000472
gdpo:GDPO0000472 rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( cco:ont00000958
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onClass gdpo:GDPO0000003 ;
                                                              owl:onProperty gdpo:GDPO0000470 ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onClass <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                                              owl:onProperty gdpo:GDPO0000471 ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "design criterion–subject assessment component"@en ;
                 skos:definition "An information content entity that records exactly one selected design-principle criterion and exactly one assessed BFO entity as a bounded assessment unit within a design evaluation record."@en ;
                 skos:editorialNote "Use a separate component for each criterion–subject pair in a composite evaluation. The OWL definition and application profile keep the pair atomic without forcing a composite evaluation record to have only one criterion or one subject."@en ;
                 skos:prefLabel "design criterion–subject assessment component"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000473
gdpo:GDPO0000473 rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( gdpo:GDPO0000472
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000470 ;
                                                              owl:someValuesFrom gdpo:GDPO0000025
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000471 ;
                                                              owl:someValuesFrom gdpo:GDPO0000446
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf gdpo:GDPO0000472 ;
                 rdfs:label "design communicative-honesty assessment component"@en ;
                 skos:definition "A design criterion–subject assessment component that pairs a principle of honesty with design communication content as the assessed subject."@en ;
                 skos:prefLabel "design communicative-honesty assessment component"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000455
gdpo:GDPO0000455 rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( gdpo:GDPO0000044
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty gdpo:GDPO0000046 ;
                                                              owl:someValuesFrom gdpo:GDPO0000025
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf gdpo:GDPO0000044 ;
                 rdfs:label "design honesty evaluation"@en ;
                 skos:altLabel "honesty evaluation"@en ;
                 skos:definition "A design evaluation record that assesses a designed artifact or associated design communication content against the principle of honesty."@en ;
                 skos:editorialNote "This class captures honesty evaluations generally. It should not be interpreted as interaction-specific unless an additional interaction-process or interaction-evidence condition is asserted. More specific subclasses, such as design communicative honesty evaluation, may specialize honesty evaluations by subject matter."@en ;
                 skos:prefLabel "design honesty evaluation"@en ;
                 skos:scopeNote "Use for evaluation records in which the principle of honesty is an explicit evaluative criterion. For evaluations specifically concerning manuals, labels, advertisements, or other communication content, use design communicative honesty evaluation."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000456
gdpo:GDPO0000456 rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "design evaluation score"@en ;
                 skos:definition "An information content entity representing a score or rating assigned within a design evaluation context, typically corresponding to a specific principle criterion and a specified scoring scale."@en ;
                 skos:editorialNote "Use this reified score pattern when evaluations involve multiple principles or multiple heterogeneous scales. Avoid placing multiple raw decimals directly on the evaluation record unless the intended interpretation is unambiguous."@en ;
                 skos:prefLabel "design evaluation score"@en ;
                 skos:scopeNote "Attach one score component per (principle, scale) pair when doing multi-criterion scoring."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000461
gdpo:GDPO0000461 rdf:type owl:Class ;
                 rdfs:subClassOf cco:ont00000958 ;
                 rdfs:label "evaluation score scale specification"@en ;
                 skos:definition "An information content entity that specifies how to interpret evaluation score values (e.g., scale type, bounds, units, and meaning)."@en ;
                 skos:editorialNote "Examples include: \"0–1 normalized ratio\", \"Likert 1–5\", \"percentage (0–100%)\", or \"ordinal grade A–F\". Use this to prevent misleading comparisons across methods or principles."@en ;
                 skos:prefLabel "evaluation score scale specification"@en .


#################################################################
#    Individuals
#################################################################

###  https://www.ramsprinciplesofgooddesign.com/GDPO0000065
gdpo:GDPO0000065 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000034 ;
                 gdpo:GDPO0000060 gdpo:GDPO0000066 ,
                                  gdpo:GDPO0000067 ,
                                  gdpo:GDPO0000068 ,
                                  gdpo:GDPO0000069 ,
                                  gdpo:GDPO0000070 ,
                                  gdpo:GDPO0000071 ,
                                  gdpo:GDPO0000072 ,
                                  gdpo:GDPO0000073 ,
                                  gdpo:GDPO0000074 ,
                                  gdpo:GDPO0000075 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "rams ten principles specification 001"@en ;
                 skos:definition "A canonical normative information content entity representing the set of Dieter Rams' ten principles of good design."@en ;
                 skos:prefLabel "rams ten principles specification 001"@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000066
gdpo:GDPO0000066 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000020 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000076 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of innovativeness 001"@en ;
                 skos:prefLabel "principle of innovativeness 001"@en ;
                 gdpo:GDPO0000453 "Good design is innovative."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000067
gdpo:GDPO0000067 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000021 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000077 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of usefulness 001"@en ;
                 skos:prefLabel "principle of usefulness 001"@en ;
                 gdpo:GDPO0000453 "Good design makes a product useful."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000068
gdpo:GDPO0000068 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000022 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000078 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of aesthetics 001"@en ;
                 skos:prefLabel "principle of aesthetics 001"@en ;
                 gdpo:GDPO0000453 "Good design is aesthetic."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000069
gdpo:GDPO0000069 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000023 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000079 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of understandability 001"@en ;
                 skos:prefLabel "principle of understandability 001"@en ;
                 gdpo:GDPO0000453 "Good design makes a product understandable."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000070
gdpo:GDPO0000070 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000024 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000080 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of unobtrusiveness 001"@en ;
                 skos:prefLabel "principle of unobtrusiveness 001"@en ;
                 gdpo:GDPO0000453 "Good design is unobtrusive."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000071
gdpo:GDPO0000071 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000025 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000081 ,
                                  gdpo:GDPO0000086 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of honesty 001"@en ;
                 skos:prefLabel "principle of honesty 001"@en ;
                 gdpo:GDPO0000453 "Good design is honest."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000072
gdpo:GDPO0000072 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000026 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000082 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of durability 001"@en ;
                 skos:prefLabel "principle of durability 001"@en ;
                 gdpo:GDPO0000453 "Good design is long-lasting."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000073
gdpo:GDPO0000073 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000027 ;
                 gdpo:GDPO0000062 gdpo:GDPO0000083 ;
                 dcterms:creator "Dieter Rams"@en ;
                 dcterms:source <https://www.vitsoe.com/us/about/good-design> ;
                 rdfs:label "principle of thoroughness 001"@en ;
                 skos:prefLabel "principle of thoroughness 001"@en ;
                 gdpo:GDPO0000453 "Good design is thorough down to the last detail."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000074
gdpo:GDPO0000074 rdf:type owl:NamedIndividual ,
                          gdpo:GDPO0000028 ;
