                                                                               owl:allValuesFrom gdpo:GDPO0000039
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000454 ;
                                   owl:allValuesFrom gdpo:GDPO0000008
                                 ] ;
                 rdfs:label "principle of unobtrusiveness"@en ;
                 skos:definition "A design principle that aims at the artifact-side target design unobtrusiveness quality."@en ;
                 skos:editorialNote "Keep distinct from minimalism; unobtrusive designs may still exhibit richness when the context requires (e.g., safety signaling)."@en ,
                                    "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ;
                 skos:prefLabel "principle of unobtrusiveness"@en ;
                 skos:scopeNote "Directs designers to create artifacts that blend harmoniously with their environment without dominating attention."@en .


