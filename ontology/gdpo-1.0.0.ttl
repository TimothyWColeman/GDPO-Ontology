                                                                               owl:allValuesFrom gdpo:GDPO0000016
                                                                             ]
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty gdpo:GDPO0000063 ;
                                                                               owl:allValuesFrom gdpo:GDPO0000039
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ]
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000454 ;
                                   owl:allValuesFrom gdpo:GDPO0000007
                                 ] ;
                 rdfs:label "principle of understandability"@en ;
                 skos:definition "A design principle that aims at the artifact-side target design understandability."@en ;
                 skos:editorialNote "Link to cognitive uptake processes of typical users; retain distinction from usefulness, which concerns end-directed adequacy."@en ,
                                    "Modeling note: What this principle prescribes is represented via design process prescription components (see has prescription component), rather than being constitutive of the principle class identity."@en ;
                 skos:prefLabel "principle of understandability"@en ;
                 skos:scopeNote "Ensures artifacts are self-explanatory, with affordances and mappings that users can readily grasp."@en .


###  https://www.ramsprinciplesofgooddesign.com/GDPO0000024
gdpo:GDPO0000024 rdf:type owl:Class ;
                 rdfs:subClassOf gdpo:GDPO0000003 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gdpo:GDPO0000062 ;
                                   owl:someValuesFrom [ owl:intersectionOf ( gdpo:GDPO0000061
                                                                             [ rdf:type owl:Restriction ;
